hbf{F}_{\\text{GA}} = \\frac{Gm(2m)}{1} \\hat{\\mathbf{j}} \\quad (2)$$", chunk_id:"b89673715e64b71ff8daeca3e51f5c5b", next_chunk_id:"c6461281d372bdebecc17bebe018de92"}}, {_id:803, properties:{text_embedding:[-0.03249000012874603, -0.0012604162329807878, -0.004639820661395788, -0.041506920009851456, 0.011986842378973961, -0.03702685609459877, -0.025829194113612175, 0.039443206042051315, -0.016787782311439514, -0.007991659455001354, -0.04884166270494461, 0.05348800867795944, -0.030630633234977722, 0.006390055175870657, -0.03043162263929844, 0.004864035174250603, 0.014621834270656109, 0.0036769011057913303, -0.008132091723382473, 0.04316967725753784, -0.0026604803279042244, 0.019795240834355354, 0.021784694865345955, 0.03601928800344467, 0.004622892942279577, 0.04979732260107994, 0.009486542083323002, 0.01544226985424757, 0.002426335122436285, 0.04186965525150299, 0.03367249667644501, -0.006844079587608576, 0.04046256095170975, -0.05685073137283325, 0.026399269700050354, 0.001985951792448759, -0.026877794414758682, -0.002142916200682521, -0.04796250909566879, 5.666267243213952E-4, -0.018691521137952805, -0.05533721670508385, 0.007455873303115368, -0.049752067774534225, 0.03945491835474968, -0.03372076153755188, -0.037615008652210236, -0.0474059171974659, 0.008108431473374367, 0.007182271685451269, -0.027216948568820953, -0.03224863484501839, 0.08161351829767227, 0.018735630437731743, 0.013717609457671642, 0.010709025897085667, -0.06052238866686821, -0.048667069524526596, -0.05548998340964317, -0.027500169351696968, 0.01899990439414978, 0.049198217689991, -0.07525987923145294, 0.03004501946270466, 0.0497485026717186, 0.012856684625148773, 0.026882372796535492, -0.020346300676465034, -0.027510156854987144, -0.02612113207578659, 0.005306825507432222, 0.026964455842971802, -0.021197736263275146, -0.013538460247218609, -0.03279732167720795, 0.04734162241220474, -0.009552646428346634, -0.0046783569268882275, 0.0314776785671711, 0.04582322761416435, 0.020154908299446106, -0.