5af8fbffa9", next_chunk_id:"e5d40dd82df558b60e8a2d29c17ecc18"}}, {_id:780, properties:{text_embedding:[-0.06705772131681442, 0.015603670850396156, 0.003382342867553234, 0.015996072441339493, -0.016772324219346046, -0.055227044969797134, 0.002955028088763356, -0.017827190458774567, 0.006487196311354637, 0.012325312942266464, -0.010471637360751629, -0.013237124308943748, -0.005543815437704325, -0.02331768535077572, 0.006084030494093895, 0.015862882137298584, 0.031181925907731056, 0.031103679910302162, 0.043573047965765, -0.03172467648983002, -0.02708899974822998, -0.014713263139128685, 0.029081668704748154, 0.019057048484683037, -0.040574464946985245, 0.038337863981723785, -0.01479980256408453, 0.005075051914900541, 1.0045550880022347E-4, -0.020760323852300644, -9.925480699166656E-4, -0.018889887258410454, 0.012063206173479557, 0.002175693865865469, 0.005403945222496986, -0.04863255098462105, 0.003419871674850583, -0.004684345331043005, -0.013844514265656471, -8.916804217733443E-4, -0.04764425754547119, -1.0349304648116231E-4, 0.03266502544283867, -0.04700491204857826, -4.773589171236381E-5, -0.03219062462449074, 0.005946854595094919, -0.024227259680628777, 0.013238074257969856, -0.0681443139910698, -0.034156434237957, 0.03675736114382744, 0.05452808737754822, -0.035798266530036926, -0.053122881799936295, 0.009209019131958485, -0.040901895612478256, -0.04353826493024826, -0.018644245341420174, 0.008943375200033188, -0.04421918839216232, 0.024619780480861664, -0.039246171712875366, -0.008502804674208164, 0.006758339237421751, 0.05711672082543373, -0.030801620334386826, 0.04522160813212395, -0.012397979386150837, -0.03877781704068184, 0.005961128976196051, 0.025583649054169655, -0.0012775228824466467, -0.009374893270432949, -0.05293327569961548, 0.024848071858286858, -0.03599695861339569, -0.002956702606752515, -0.025099894031882286, 0.009626167826354504, 0.024007411673665047, -0.0010909114498645067, 0.010735620744526386, 0.008728386834263802, 0.02627522684633732, -0.00