3635, 0.01080287154763937, -0.04260890558362007, -0.03968808427453041, -0.013514548540115356, -0.05225558578968048, -0.00612405501306057, 0.023651231080293655, 0.034394074231386185, -0.009217537939548492, -0.03450668603181839, 0.024446940049529076, -0.030084701254963875, 0.04924330115318298, 0.007175547070801258, -0.0299778301268816, 0.04201541468501091, 0.020225536078214645, -0.010303383693099022, -0.024559129029512405, 0.0017330587143078446, 0.028975429013371468, -0.02536889910697937, -0.0470527745783329, 0.022526858374476433, 0.014853139407932758, -0.04915193095803261, 0.013592036440968513, 0.011732764542102814, -0.016175465658307076, -0.02242502197623253, -0.01912030205130577, 0.0014184039318934083, 0.0426214374601841, -0.01018636953085661, 0.0063773998990654945, 0.04391862824559212, 0.005523049272596836, 0.046079203486442566, -0.006855406798422337, 0.08478810638189316, 0.028796100988984108, -0.010410888120532036, 0.009765082970261574], images:"_page_5_Diagram_5.jpeg", previous_chunk_id:"b62d2dc92e6004ebb51a171c6ac390b9", has_images:true, header:"**7.4 THE GRAVITATIONAL CONSTANT**", source:"processed_notes_with_descriptions.md", text:"$$F'_{GA} = \\frac{G2m.2m}{1} \\hat{j} = 4Gm^2 \\hat{j}$$  \n$$\\mathbf{F}'_{GB} = \\mathbf{F}_{GB} \\quad \\text{and} \\quad \\mathbf{F}'_{GC} = \\mathbf{F}_{GC}$$  \n$$\\mathbf{F}'_R = \\mathbf{F}'_{GA} + \\mathbf{F}'_{GB} + \\mathbf{F}'_{GC}$$  \n$$F'_R = 2 G m^2 \\hat{j}$$  \n⊳  \nFor the gravitational force between an extended object (like the earth) and a point mass, Eq. (7.5) is not directly applicable. Each point mass in the extended object will exert a force on the given point mass and these force will not all be in the same direction. We have to add up these forces vectorially for all the point masses in the extended object to get the total force. This is easily done using calculus. For two special  \n![](_page_5_Diagram_5.jpeg)  \n> **Figure Description (llava:latest):**\n> The image depicts an illustration of a situation involving gravitational forces acting between a spherical object and smaller objects that are attached to a bar in a specific arrangement.\n>\n> In the diagram:", chunk_id:"ca45a56227ab7a3e45afac88f5c3b368", next_chunk_id:"db2b2df952d795fca068faa233f7676b"}}, {_id:807, properties:{text_embedding:[0.002121418248862028, 0.02876051515340805, -0.06578998267650604, -0.03537818044424057, -0.024939339607954025, -0.05801134929060936, 0.017511004582047462, 0.01917678490281105, 0.039132945239543915, 0.020402465015649796, -0.006428673397749662, 0.028221236541867256, 0.006400430109351873, -0.009904466569423676, -0.03975924104452133, 0.034196753054857254, 0.04660256206989288, 0.010132458992302418, 0.013653535395860672, 0.022173278033733368, -0.01785675436258316, 0.01938706636428833, -0.059294551610946655, -0.018580036237835884, -0.047201968729496, 0.04212150722742081, -0.03585027903318405, 0.0383094847202301, -0.03557441383600235, 0.0172746405005455, -0.006723243277519941, -0.047585345804691315, 0.042605843394994736, 0.01901506632566452, -0.01171373575925827, -0.02369081787765026, 0.004604732152074575, -0.022181719541549683, -0.03969006985425949, 0.0088370181620121, -0.04648807272315025, -0.026327867060899734, 0.05033523961901665, -0.04333094507455826, 0.01783340610563755, -0.03857436031103134, -0.04305751994252205, -0.031128380447626114, -0.03736629709601402, -0.042679984122514725, -0.02903747372329235, -0.012366103008389473, 0.028062226250767708, -1.42773671541363E-4, -0.04129674658179283, 0.007945776917040348, -0.04800080135464668, -0.04481589049100876, -0.032271858304739, -0.010152996517717838, -0.03452228009700775, 0.027245376259088516, -0.0023895788472145796, -0.008014712482690811, 0.022716224193572998, 0.06449344009160995, -0.024340331554412842, 0.018616972491145134, -0.03344899043440819, -0.0360996350646019, -0.01858554594218731, 0.004907126072794199, 0.028070664033293724, 0.007766833063215017, -5.946061355643906E-5, 0.00796540081501007, -0.03972579166293144, -0.003179