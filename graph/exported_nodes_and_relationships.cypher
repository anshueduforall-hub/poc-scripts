f96edeea579b", next_chunk_id:"7f72763f9f1097ef73d4c3089526da4c"}}, {_id:828, properties:{text_embedding:[-0.022068891674280167, 0.05122801288962364, 0.019735001027584076, 0.01519309263676405, -0.008918331004679203, -0.007732063066214323, 0.03815178945660591, 0.01896537095308304, -0.005990399979054928, 0.0015362836420536041, 0.013706698082387447, 0.007879066281020641, -0.01750098541378975, -0.007422907743602991, -0.013550045900046825, -0.015820296481251717, 0.008500423282384872, 0.050631534308195114, 0.04806733503937721, -0.017431043088436127, 0.005709039978682995, -0.02089734748005867, -0.020852796733379364, 0.05691633000969887, -0.00481286970898509, 0.008524082601070404, 0.001633013249374926, -0.002059871330857277, 0.03602670133113861, 0.043517544865608215, -0.018842153251171112, -0.0483035147190094, 0.01855630986392498, -0.05634742230176926, 0.010735872201621532, -0.02760923281311989, -0.026274172589182854, -0.019476013258099556, -0.031350042670965195, 0.010999745689332485, -0.02099393680691719, -0.04638233035802841, 0.04475835710763931, -0.038164082914590836, -0.007290869019925594, -0.041588377207517624, -0.03942510858178139, -0.03748686984181404, -0.041103143244981766, -0.06725717335939407, -0.03172169253230095, -0.022752467542886734, 0.07230906188488007, -0.02092180959880352, -0.009679690934717655, -0.00969183910638094, -0.06653151661157608, -0.0018456351244822145, -0.09524380415678024, -0.022584354504942894, -0.015468760393559933, 0.019331499934196472, -0.06165533885359764, -0.048575904220342636, 0.005120013374835253, 0.015886057168245316, -0.00787133164703846, 0.05663640797138214, -0.01382686011493206, 0.01270358357578516, -0.018153604120016098, 0.03729359805583954, -0.011692730709910393, -0.003288641106337309, -0.07209613919258118, 0.029629817232489586, -0.008134308271110058, 0.011676082387566566, 0.004386949818581343, -0.0038133489433676004, -0.018721379339694977, -7.583837141282856E-4, -0.014855591580271721, -0.005623153876513243, -0.0032930737361311913, 0