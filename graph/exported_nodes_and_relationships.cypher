005158104468137026, -0.01010086014866829, -0.0013544895919039845, -0.02931935340166092, -0.007004096172749996, -0.004495278466492891, 0.022432221099734306, -0.03250201418995857, -0.045191407203674316, 0.01291669625788927, 0.02739350125193596, -0.0015276623889803886, -0.004447196144610643, 0.03741615265607834, 0.011438763700425625, -0.021410617977380753, -0.033978164196014404, -0.02987070195376873, -0.02977663278579712, 0.039165858179330826, 0.00635371683165431, 0.03120465949177742, -0.0297820046544075, -0.040500957518815994, -0.014790384098887444, 0.0010748357744887471, -0.048260029405355453, 0.013132295571267605, 0.003141460008919239, 0.041505228728055954, 0.006960594095289707, 0.02870771661400795, 0.023097094148397446, 0.03495636582374573, -0.004423103295266628, 0.0427585244178772, -0.026886949315667152, -0.00997032318264246, 0.055326685309410095, -0.0455201230943203, 0.07388310879468918, 0.03447563946247101, -2.2509404516313225E-4, -0.004496713634580374], images:"none", previous_chunk_id:"ca45a56227ab7a3e45afac88f5c3b368", has_images:false, header:"**7.4 THE GRAVITATIONAL CONSTANT**", source:"processed_notes_with_descriptions.md", text:">\n> In the diagram:\n> - There is a large, spherical object, which is presumably the Earth due to its shape and the presence of smaller objects.\n> - Attached to a central point on the surface of this sphere are two small lead spheres. The central point could be the center of mass or gravity for the larger sphere.\n> - A bar AB connects these two small spheres, forming a straight line that bisects their centers.\n> - There is also a fine wire attached to each of the small spheres. This suggests that there are additional forces acting along this wire due to the interaction between the smaller spheres and the larger sphere or the Earth's surface.\n> - Two large lead spheres are positioned on opposite sides of the small spheres, with one sphere being nearer to the small spheres than the other. These large spheres seem to be exerting an attractive force on the small spheres.", chunk_id:"db2b2df952d795fca068faa233f7676b", next_chunk_id:"a9a0a7711e0a2d8258b96674a39a1136"}}, {_id:808, properties:{text_embedding:[0.017883075401186943, 0.025320718064904213, -0.038611121475696564, -0.013302989304065704, 0.006281695328652859, -0.05632661283016205, -0.030111154541373253, 0.03957737237215042, 0.027213867753744125, -0.034515973180532455, 0.0033288970589637756, 0.010716356337070465, -0.03251832723617554, 0.006985508371144533, -0.04235931485891342, 0.0022513384465128183, 0.039038535207509995, -0.010400477796792984, 0.005988159216940403, 0.01160260196775198, -0.003358599031344056, 0.008119621314108372, -0.04220085218548775, 0.030500859022140503, 0.01929526962339878, 0.04252556711435318, 0.004643426276743412, 0.03474549576640129, 0.01856181025505066, 0.036403872072696686, 0.014247458428144455, -0.01984911598265171, -0.005380378570407629, -0.04425361379981041, 0.001094770967029035, -0.009095768444240093, -0.03119276463985443, -0.04108341410756111, -0.027678338810801506, 0.04803994670510292, -0.02737964130938053, -0.04919265955686569, 0.025723375380039215, -0.02687409147620201, -0.015368537977337837, -0.04465366527438164, -0.0319136343896389, -0.041585773229599, -0.04345916584134102, -0.01784726046025753, -0.03138001635670662, -0.0549047589302063, 0.06579509377479553, -0.012540061958134174, -0.008137035183608532, 0.019894549623131752, -0.03276240453124046, -0.03898719698190689, -0.03960870951414108, -0.033585332334041595, -0.017929337918758392, 0.030265383422374725, -0.04560822993516922, -0.015853852033615112, -0.003363013034686446, 0.046664051711559296, -0.011810214258730412, 0.016794484108686447, -0.020436391234397888, -0.04030792787671089, -0.009468264877796173, 0.02137123793363571, 0.015933049842715263, -0.05003600940108299, -0.044198278337717056, 0.025842400267720222, -0.0694701224565506, -0.005608581006526947, -0.04135838896036148, -0.011706220917403698, 0.0017438586801290512, 0.021677663549780846, 0.025